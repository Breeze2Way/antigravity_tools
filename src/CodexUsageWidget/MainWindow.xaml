<Window x:Class="CodexUsageWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex 剩余用量"
        Width="68"
        Height="68"
        MinWidth="68"
        MinHeight="68"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Window.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#E60B1728" />
            <Setter Property="Foreground" Value="#F5FAFF" />
            <Setter Property="BorderBrush" Value="#8059C7FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="ToolTipService.HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18"
                                                  ShadowDepth="0"
                                                  Opacity="0.65"
                                                  Color="#3AB8FF" />
                            </Border.Effect>
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu MinWidth="170"
                     Padding="4"
                     FontSize="13"
                     HasDropShadow="True">
            <MenuItem Header="刷新" Click="Refresh_Click" Padding="10,6" />
            <MenuItem Header="设置" Click="Settings_Click" Padding="10,6" />
            <Separator />
            <MenuItem Header="打开官方用量" Click="OfficialUsage_Click" Padding="10,6" />
            <MenuItem Header="退出" Click="Exit_Click" Padding="10,6" />
        </ContextMenu>
    </Window.ContextMenu>

    <Border x:Name="Card"
            Background="Transparent"
            BorderThickness="0"
            Padding="0">
        <Grid>
            <Grid x:Name="DashboardPanel">
                <Grid x:Name="WaterBallHost"
                      Background="Transparent"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown"
                      ToolTipService.InitialShowDelay="150"
                      ToolTipService.ShowDuration="60000"
                      ToolTipService.BetweenShowDelay="100" />
            </Grid>

            <Grid x:Name="SettingsPanel" Visibility="Collapsed" Margin="12,8,12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="36" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0"
                      Background="Transparent"
                      Cursor="SizeAll"
                      MouseLeftButtonDown="SettingsHeader_MouseLeftButtonDown" />
                <TextBlock Text="小工具设置"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="周额度（可选 token）"
                               Foreground="#B9C7D8"
                               VerticalAlignment="Center" />
                    <TextBox x:Name="WeeklyBudgetBox" Grid.Column="1" Margin="8,0,0,0" />
                    <TextBlock Text="刷新间隔（秒）"
                               Grid.Row="1"
                               Foreground="#B9C7D8"
                               VerticalAlignment="Center" />
                    <TextBox x:Name="RefreshSecondsBox" Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" />
                    <TextBlock Text="透明度"
                               Grid.Row="2"
                               Foreground="#B9C7D8"
                               VerticalAlignment="Center" />
                    <Slider x:Name="OpacitySlider"
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Minimum="45"
                            Maximum="100"
                            TickFrequency="5"
                            IsSnapToTickEnabled="True" />
                    <CheckBox x:Name="TopmostBox"
                              Grid.Row="3"
                              Grid.Column="0"
                              Content="窗口置顶"
                              Foreground="White"
                              VerticalAlignment="Center" />
                    <CheckBox x:Name="AutoStartBox"
                              Grid.Row="3"
                              Grid.Column="1"
                              Content="开机启动"
                              Foreground="White"
                              VerticalAlignment="Center" />
                </Grid>
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="取消" Click="SettingsCancel_Click" Padding="12,4" />
                    <Button Content="保存" Click="SettingsSave_Click" Padding="12,4" Margin="8,0,0,0" Background="#0E7490" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
